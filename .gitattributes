# What stays in the repository but is not part of the release ZIP (`git archive` honours export-ignore).
# The ZIP is the plugin itself: its code, readme.txt, translations, assets and the documents readme.txt points to (docs/).
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitleaksignore export-ignore
/tests export-ignore
/tools export-ignore
/build export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpcs.xml export-ignore
/phpstan.neon export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.xml export-ignore
/plugin-info.json export-ignore
/README.md export-ignore
/ROADMAP.md export-ignore
/TESTING.md export-ignore
/LICENSE-PLAN.md export-ignore
/LICENSE-IMPLEMENTATION-PROMPT.md export-ignore
