{
  "name": "eshaanmanchanda/wp-dynamic-tags",
  "description": "WP Dynamic Tags WordPress Plugin",
  "type": "wordpress-plugin",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^10",
    "squizlabs/php_codesniffer": "^3",
    "wp-coding-standards/wpcs": "^3",
    "phpstan/phpstan": "^1",
    "szepeviktor/phpstan-wordpress": "^1"
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox",
    "lint": "vendor/bin/phpcs --standard=WordPress includes/ admin/",
    "lint-fix": "vendor/bin/phpcbf --standard=WordPress includes/ admin/",
    "analyse": "vendor/bin/phpstan analyse includes/ admin/ --level=5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
