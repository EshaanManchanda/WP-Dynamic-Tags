includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
  - phpstan-baseline.neon

parameters:
  level: 5
  phpVersion: 80200
  paths:
    - includes
    - admin
    - wp-dynamic-tags.php
  ignoreErrors:
    # ACF is an optional third-party dependency; its stubs are not installed.
    - '#Function get_field_object not found#'
    # WP-CLI is only present when WP-CLI itself runs; no stubs are installed (adding php-stubs/wp-cli-stubs would be a new dev dependency).
    - '#Call to static method \w+\(\) on an unknown class WP_CLI\.#'
