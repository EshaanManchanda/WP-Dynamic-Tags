parameters:
	ignoreErrors:
		-
			message: "#^Parameter \\#1 \\$text of function esc_html expects string, int\\<0, max\\> given\\.$#"
			count: 1
			path: admin/settings-page.php

		-
			message: "#^Parameter \\#2 \\$array of function implode expects array\\<string\\>, array\\<int, array\\<int, string\\>\\|string\\> given\\.$#"
			count: 1
			path: includes/class-table-import-export.php

		-
			message: "#^Parameter \\#2 \\$value of method SimpleXMLElement\\:\\:addChild\\(\\) expects string\\|null, int\\<0, max\\> given\\.$#"
			count: 1
			path: includes/class-table-import-export.php

		-
			message: "#^Property WP_Dynamic_Tags_Table_Manager\\:\\:\\$cache_expiry is never read, only written\\.$#"
			count: 1
			path: includes/class-table-manager.php

		-
			message: "#^Access to an undefined property object\\:\\:\\$id\\.$#"
			count: 1
			path: includes/class-table-shortcode-processor.php

		-
			message: "#^Access to an undefined property object\\:\\:\\$children\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Parameter \\#1 \\$text of function esc_attr expects string, int given\\.$#"
			count: 2
			path: includes/class-tag-groups.php

		-
			message: "#^Property WP_Dynamic_Tags_Groups\\:\\:\\$cache_version is never read, only written\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Property WP_Term\\:\\:\\$name \\(string\\) in isset\\(\\) is not nullable\\.$#"
			count: 3
			path: includes/class-tag-groups.php

		-
			message: "#^Property WP_Term\\:\\:\\$term_id \\(int\\) in isset\\(\\) is not nullable\\.$#"
			count: 4
			path: includes/class-tag-groups.php

		-
			message: "#^Result of && is always true\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Result of \\|\\| is always false\\.$#"
			count: 6
			path: includes/class-tag-groups.php

		-
			message: "#^Strict comparison using \\=\\=\\= between 1\\|2 and \\-1 will always evaluate to false\\.$#"
			count: 3
			path: includes/class-tag-groups.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 5
			path: includes/class-tag-groups.php

		-
			message: "#^Variable \\$group_badges in empty\\(\\) always exists and is not falsy\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^If condition is always false\\.$#"
			count: 1
			path: wp-dynamic-tags.php

		-
			message: "#^Property WP_Dynamic_Tags_Plugin\\:\\:\\$tag_groups is never read, only written\\.$#"
			count: 1
			path: wp-dynamic-tags.php
