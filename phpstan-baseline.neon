parameters:
	ignoreErrors:
		-
			message: "#^Property WP_Dynamic_Tags_Table_Manager\\:\\:\\$cache_expiry is never read, only written\\.$#"
			count: 1
			path: includes/class-table-manager.php

		-
			message: "#^Access to an undefined property object\\:\\:\\$id\\.$#"
			count: 1
			path: includes/class-table-shortcode-processor.php

		-
			message: "#^Access to an undefined property object\\:\\:\\$children\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Property WP_Term\\:\\:\\$term_id \\(int\\) in isset\\(\\) is not nullable\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Result of && is always true\\.$#"
			count: 1
			path: includes/class-tag-groups.php

		-
			message: "#^Strict comparison using \\=\\=\\= between 1\\|2 and \\-1 will always evaluate to false\\.$#"
			count: 3
			path: includes/class-tag-groups.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 5
			path: includes/class-tag-groups.php

		-
			message: "#^If condition is always false\\.$#"
			count: 1
			path: wp-dynamic-tags.php

		-
			message: "#^Property WP_Dynamic_Tags_Plugin\\:\\:\\$tag_groups is never read, only written\\.$#"
			count: 1
			path: wp-dynamic-tags.php
